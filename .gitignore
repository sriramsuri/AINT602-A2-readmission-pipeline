*.log
_build_*
build/
dist/

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# MLflow local run store: kept local, not committed, because its metadata embeds
# absolute machine paths. The committed structured evidence (artifacts/*.json) plus an
# MLflow screenshot in the appendix cover experiment tracking instead.
mlruns/

# Committed on purpose: artifacts/ (model, metrics, reports) and reports/figures/.
# They are the evidence that the pipeline ran, which the appendix refers to.
